{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source scraping Espejismo",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "auto", "wideLayout": true },
      "pluginVersion": "10.0.0",
      "targets": [{ "editorMode": "code", "expr": "espejismo_active_physical_connections{job=~\"$job\",instance=~\"$instance\"}", "legendFormat": "{{instance}}", "refId": "A" }],
      "title": "Active physical connections",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showPercentChange": false, "textMode": "auto", "wideLayout": true },
      "pluginVersion": "10.0.0",
      "targets": [{ "editorMode": "code", "expr": "espejismo_active_streams{job=~\"$job\",instance=~\"$instance\"}", "legendFormat": "{{instance}}", "refId": "A" }],
      "title": "Active streams",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "Bps", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "10.0.0",
      "targets": [
        { "editorMode": "code", "expr": "sum by (instance) (rate(espejismo_bytes_client_to_remote_total{job=~\"$job\",instance=~\"$instance\"}[5m]))", "legendFormat": "{{instance}} client → remote", "refId": "A" },
        { "editorMode": "code", "expr": "sum by (instance) (rate(espejismo_bytes_remote_to_client_total{job=~\"$job\",instance=~\"$instance\"}[5m]))", "legendFormat": "{{instance}} remote → client", "refId": "B" }
      ],
      "title": "Tunnel payload throughput",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "ops", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "id": 4,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "10.0.0",
      "targets": [
        { "editorMode": "code", "expr": "sum by (instance) (rate(espejismo_handshake_success_total{job=~\"$job\",instance=~\"$instance\"}[5m]))", "legendFormat": "{{instance}} success", "refId": "A" },
        { "editorMode": "code", "expr": "sum by (instance) (rate(espejismo_handshake_failure_total{job=~\"$job\",instance=~\"$instance\"}[5m]))", "legendFormat": "{{instance}} failure", "refId": "B" }
      ],
      "title": "Handshake rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "ops", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "10.0.0",
      "targets": [
        { "editorMode": "code", "expr": "sum by (instance) (rate(espejismo_stream_opened_total{job=~\"$job\",instance=~\"$instance\"}[5m]))", "legendFormat": "{{instance}} opened", "refId": "A" },
        { "editorMode": "code", "expr": "sum by (instance) (rate(espejismo_stream_failed_total{job=~\"$job\",instance=~\"$instance\"}[5m]))", "legendFormat": "{{instance}} failed", "refId": "B" }
      ],
      "title": "Stream open and failure rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "ms", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "10.0.0",
      "targets": [{ "editorMode": "code", "expr": "espejismo_tunnel_lane_last_mux_rtt_ms{job=~\"$job\",instance=~\"$instance\"}", "legendFormat": "{{instance}} lane {{lane_id}} ({{lane_kind}})", "refId": "A" }],
      "title": "Local tunnel lane mux RTT",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["espejismo", "prometheus"],
  "templating": {
    "list": [
      { "current": { "selected": false, "text": "espejismo", "value": "espejismo" }, "hide": 0, "includeAll": false, "label": "Job", "multi": false, "name": "job", "options": [], "query": "espejismo", "refresh": 1, "type": "query", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } },
      { "current": { "selected": false, "text": "All", "value": "$__all" }, "hide": 0, "includeAll": true, "allValue": ".*", "label": "Instance", "multi": true, "name": "instance", "options": [], "query": "label_values(up{job=~\"$job\"}, instance)", "refresh": 2, "type": "query", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Espejismo Operations",
  "uid": "espejismo-operations",
  "version": 1,
  "weekStart": ""
}
